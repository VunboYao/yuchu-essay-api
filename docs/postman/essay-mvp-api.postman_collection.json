  "item": [
    {
      "name": "01 健康检查",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "详见 course_server/docs/api-reference.md"
          }
        }
      ]
    },
    {
      "name": "02 Admin 认证",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/api/v1/auth/login",
            "description": "详见 course_server/docs/api-reference.md",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('code is 0', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(0);",
                  "    if (json.data && json.data.token) {",
                  "        pm.environment.set('adminToken', json.data.token);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
